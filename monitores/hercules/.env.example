HERCULES_URL=https://sistemahercules.bienestarcompensar.com/
HERCULES_REPORT_URL=https://sistemahercules.bienestarcompensar.com/sistema.php/reportes/estadisticas#/

AUTO_LOGIN=true
HERCULES_USERNAME=TU_USUARIO
HERCULES_PASSWORD=TU_CLAVE

HEADLESS=true
TIMEOUT_MS=60000

# Flujo nuevo:
# 0 = hoy. Este es el reporte que se usa para validar alertas y dashboard diario.
HERCULES_DIAS_ATRAS_DIARIO=0

# 1 = ayer. Este es el reporte que se agrega al acumulado mensual.
HERCULES_DIAS_ATRAS_ACUMULADO=1

# Ruta local de OneDrive/SharePoint sincronizada.
SHAREPOINT_SYNC_DIR=C:\Users\esteban\OneDrive - Compensar\COORDINACION SOPORTE SOLUCIONES - Monitoreo diario\HERCULES

# Vacío = mes actual según la fecha del reporte acumulado.
MES_CONSOLIDAR=
